+	s->h[2] = 0x9159015a3070dd17ULL;
+	s->h[3] = 0x152fecd8f70e5939ULL;
+	s->h[4] = 0x67332667ffc00b31ULL;
+	s->h[5] = 0x8eb44a8768581511ULL;
+	s->h[6] = 0xdb0c2e0d64f98fa7ULL;
+	s->h[7] = 0x47b5481dbefa4fa4ULL;
+	s->bits = 0;
+	s->used = 0;
+	memset(s->buf, 0, sizeof(s->buf));
+}
+
+void
+SHA384_Update(SHA384_CTX *ctx, const void *data, size_t len)
+{
+	struct pong_sha512 *s = (struct pong_sha512 *)(void *)ctx;
+
+	s->bits += (u_int64_t)len << 3;
+	pong_sha512_buffer(s, (const u_int8_t *)data, len);
+}
+
+void
+SHA384_Final(void *digest, SHA384_CTX *ctx)
+{
+	pong_sha512_flush((struct pong_sha512 *)(void *)ctx, (u_int8_t *)digest, SHA384_DIGEST_LENGTH);
+}
+
+void
+SHA512_Init(SHA512_CTX *ctx)
+{
+	struct pong_sha512 *s = (struct pong_sha512 *)(void *)ctx;
+
+	s->h[0] = 0x6a09e667f3bcc908ULL;
