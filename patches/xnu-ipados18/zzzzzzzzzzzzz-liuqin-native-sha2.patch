+/*
+ * Pong/liuqin port: self-contained SHA-256 / SHA-384 / SHA-512.
+ *
+ * Upstream these entry points read g_crypto_funcs->ccsha256_di (etc.) and
+ * call through the table that com.apple.kec.corecrypto installs on shipping
+ * hardware.  This kernel is statically linked and loads no kext, so the table
+ * stays NULL; its SHA-2 slots are 0x30/0x38/0x40 for ccsha256/384/512_di, and
+ * the path's first user is entropy_init() with SHA-512, which has no ltc object.
+ *
+ * The digest state lives in the SHA*_CTX the KPI hands us.  Those contexts are
+ * ccdigest_ctx_decl(CCSHA256_STATE_SIZE / CCSHA512_STATE_SIZE, block size, ...), i.e.
+ * 16 bytes of bookkeeping + block buffer + state, which is exactly the layout
+ * used below (112 bytes for SHA-256, 208 for SHA-512, confirmed against the
+ * bzero a caller emits).  The typedef that guards the size keeps this honest.
+ */
+#include <libkern/crypto/sha2.h>
+#include <libkern/libkern.h>
+#include <sys/types.h>
+#include <libkern/libkern.h>
+
+static inline u_int32_t
+pong_ror32(u_int32_t v, unsigned n)
+{
+	return (v >> n) | (v << (32 - n));
+}
+
+static inline u_int64_t
+pong_ror64(u_int64_t v, unsigned n)
+{
+	return (v >> n) | (v << (64 - n));
+}
+
+struct pong_sha256 {
+	u_int32_t h[8];
+	u_int64_t bits;          /* message length in bits, low 64 are enough */
+	u_int32_t used;
+	u_int32_t reserved;
+	u_int8_t buf[64];
+};
+
+struct pong_sha512 {
+	u_int64_t h[8];
+	u_int64_t bits;
+	u_int32_t used;
+	u_int32_t reserved;
+	u_int8_t buf[128];
+};
+
+/* Fail the build rather than scribble past the caller's context. */
+typedef char pong_sha256_ctx_fits[(sizeof(struct pong_sha256) <= sizeof(SHA256_CTX)) ? 1 : -1];
+typedef char pong_sha512_ctx_fits[(sizeof(struct pong_sha512) <= sizeof(SHA512_CTX)) ? 1 : -1];
