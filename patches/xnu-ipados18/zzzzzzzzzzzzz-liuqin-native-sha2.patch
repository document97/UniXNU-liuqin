+static void
+pong_sha256_compress(u_int32_t h[8], const u_int8_t block[64])
+{
+	u_int32_t w[64];
+	u_int32_t a, b, c, d, e, f, g, hh, t1, t2;
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		w[i] = ((u_int32_t)block[i * 4] << 24) | ((u_int32_t)block[i * 4 + 1] << 16) |
+		    ((u_int32_t)block[i * 4 + 2] << 8) | (u_int32_t)block[i * 4 + 3];
+	}
+	for (i = 16; i < 64; i++) {
+		u_int32_t s0 = pong_ror32(w[i - 15], 7) ^ pong_ror32(w[i - 15], 18) ^ (w[i - 15] >> 3);
+		u_int32_t s1 = pong_ror32(w[i - 2], 17) ^ pong_ror32(w[i - 2], 19) ^ (w[i - 2] >> 10);
+
+		w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+	}
+
+	a = h[0]; b = h[1]; c = h[2]; d = h[3];
+	e = h[4]; f = h[5]; g = h[6]; hh = h[7];
+
+	for (i = 0; i < 64; i++) {
+		u_int32_t S1 = pong_ror32(e, 6) ^ pong_ror32(e, 11) ^ pong_ror32(e, 25);
+		u_int32_t ch = (e & f) ^ (~e & g);
+		u_int32_t S0 = pong_ror32(a, 2) ^ pong_ror32(a, 13) ^ pong_ror32(a, 22);
+		u_int32_t maj = (a & b) ^ (a & c) ^ (b & c);
+
+		t1 = hh + S1 + ch + pong_sha256_k[i] + w[i];
+		t2 = S0 + maj;
+		hh = g; g = f; f = e; e = d + t1;
+		d = c; c = b; b = a; a = t1 + t2;
+	}
+
+	h[0] += a; h[1] += b; h[2] += c; h[3] += d;
+	h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
+}
+
+static void
+pong_sha512_compress(u_int64_t h[8], const u_int8_t block[128])
+{
+	u_int64_t w[80];
+	u_int64_t a, b, c, d, e, f, g, hh, t1, t2;
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		w[i] = 0;
+		for (int j = 0; j < 8; j++) {
+			w[i] = (w[i] << 8) | (u_int64_t)block[i * 8 + j];
+		}
+	}
+	for (i = 16; i < 80; i++) {
+		u_int64_t s0 = pong_ror64(w[i - 15], 1) ^ pong_ror64(w[i - 15], 8) ^ (w[i - 15] >> 7);
+		u_int64_t s1 = pong_ror64(w[i - 2], 19) ^ pong_ror64(w[i - 2], 61) ^ (w[i - 2] >> 6);
+
+		w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+	}
+
+	a = h[0]; b = h[1]; c = h[2]; d = h[3];
+	e = h[4]; f = h[5]; g = h[6]; hh = h[7];
+
+	for (i = 0; i < 80; i++) {
+		u_int64_t S1 = pong_ror64(e, 14) ^ pong_ror64(e, 18) ^ pong_ror64(e, 41);
+		u_int64_t ch = (e & f) ^ (~e & g);
+		u_int64_t S0 = pong_ror64(a, 28) ^ pong_ror64(a, 34) ^ pong_ror64(a, 39);
+		u_int64_t maj = (a & b) ^ (a & c) ^ (b & c);
+
+		t1 = hh + S1 + ch + pong_sha512_k[i] + w[i];
+		t2 = S0 + maj;
+		hh = g; g = f; f = e; e = d + t1;
+		d = c; c = b; b = a; a = t1 + t2;
+	}
+
+	h[0] += a; h[1] += b; h[2] += c; h[3] += d;
+	h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
+}
+
+static void
+pong_sha256_buffer(struct pong_sha256 *s, const u_int8_t *input, size_t len)
+{
+	while (len > 0) {
+		size_t room = 64 - s->used;
+		size_t take = (len < room) ? len : room;
+
+		memcpy(s->buf + s->used, input, take);
+		s->used += (u_int32_t)take;
+		input += take;
+		len -= take;
+
+		if (s->used == 64) {
+			pong_sha256_compress(s->h, s->buf);
+			s->used = 0;
+		}
+	}
+}
+
+static void
+pong_sha512_buffer(struct pong_sha512 *s, const u_int8_t *input, size_t len)
+{
+	while (len > 0) {
+		size_t room = 128 - s->used;
+		size_t take = (len < room) ? len : room;
+
+		memcpy(s->buf + s->used, input, take);
+		s->used += (u_int32_t)take;
+		input += take;
+		len -= take;
+
+		if (s->used == 128) {
+			pong_sha512_compress(s->h, s->buf);
+			s->used = 0;
+		}
+	}
+}
+
+static void
+pong_sha256_flush(struct pong_sha256 *s, u_int8_t *out, size_t out_len)
+{
+	u_int64_t bits = s->bits;
+	int i;
+
+	s->buf[s->used++] = 0x80;
+	if (s->used > 56) {
+		memset(s->buf + s->used, 0, 64 - s->used);
+		pong_sha256_compress(s->h, s->buf);
+		s->used = 0;
+	}
+	memset(s->buf + s->used, 0, 56 - s->used);
+	for (i = 0; i < 8; i++) {
+		s->buf[56 + i] = (u_int8_t)(bits >> (56 - 8 * i));
+	}
+	pong_sha256_compress(s->h, s->buf);
+
+	for (i = 0; i < (int)out_len && i < 32; i++) {
+		out[i] = (u_int8_t)(s->h[i >> 2] >> (24 - 8 * (i & 3)));
+	}
+	memset(s, 0, sizeof(*s));
+}
+
+static void
+pong_sha512_flush(struct pong_sha512 *s, u_int8_t *out, size_t out_len)
+{
+	u_int64_t bits = s->bits;
+	int i;
+
+	s->buf[s->used++] = 0x80;
+	if (s->used > 112) {
+		memset(s->buf + s->used, 0, 128 - s->used);
+		pong_sha512_compress(s->h, s->buf);
+		s->used = 0;
+	}
+	memset(s->buf + s->used, 0, 112 - s->used);
+	/* 128-bit length: the high half stays zero, callers stay far below 2^61 bytes */
+	memset(s->buf + 112, 0, 8);
+	for (i = 0; i < 8; i++) {
+		s->buf[120 + i] = (u_int8_t)(bits >> (56 - 8 * i));
+	}
+	pong_sha512_compress(s->h, s->buf);
+
+	for (i = 0; i < (int)out_len && i < 64; i++) {
+		out[i] = (u_int8_t)(s->h[i >> 3] >> (56 - 8 * (i & 7)));
+	}
+	memset(s, 0, sizeof(*s));
+}
+
+void
+SHA256_Init(SHA256_CTX *ctx)
+{
+	struct pong_sha256 *s = (struct pong_sha256 *)(void *)ctx;
+
+	s->h[0] = 0x6a09e667U;
+	s->h[1] = 0xbb67ae85U;
+	s->h[2] = 0x3c6ef372U;
+	s->h[3] = 0xa54ff53aU;
+	s->h[4] = 0x510e527fU;
+	s->h[5] = 0x9b05688cU;
+	s->h[6] = 0x1f83d9abU;
+	s->h[7] = 0x5be0cd19U;
+	s->bits = 0;
+	s->used = 0;
+	memset(s->buf, 0, sizeof(s->buf));
+}
+
+void
+SHA256_Update(SHA256_CTX *ctx, const void *data, size_t len)
+{
+	struct pong_sha256 *s = (struct pong_sha256 *)(void *)ctx;
+
+	s->bits += (u_int64_t)len << 3;
+	pong_sha256_buffer(s, (const u_int8_t *)data, len);
+}
+
+void
+SHA256_Final(void *digest, SHA256_CTX *ctx)
+{
+	pong_sha256_flush((struct pong_sha256 *)(void *)ctx, (u_int8_t *)digest, SHA256_DIGEST_LENGTH);
+}
+
+void
+SHA384_Init(SHA384_CTX *ctx)
+{
