# UniXNU Xiaomi Pad 6 Pro (liuqin) iPadOS 18 / Darwin 24, first-boot configuration.
# Derived from pong_ipados18_defconfig: same SM8475 CPU, timer, UFS and APFS root path.
# Off until each has liuqin inputs:
#   PONG_RAMOOPS_CONSOLE / PONG_VOLATILE_PANIC_LOG: the pong patch writes at the fixed
#     0x85200000, inside liuqin's stock PIL reservation; liuqin's ramoops is 0xA7000000.
#   PONG_POWER / PONG_BACKLIGHT: TFA9873 audio, pong battery and DSI DCS brightness;
#     liuqin has CS35L41 amplifiers and a KTZ8866 I2C backlight that the ABL leaves on.
#   PONG_ADRENO_PLATFORM: needs liuqin's own signed a730 ZAP firmware; UI renders in software.
#   PONG_WIFI: needs liuqin's QCA6490 board data.
CONFIG_XNU_ADRENO_FIRMWARE_PROBE=n
CONFIG_XNU_ADRENO_PM4_PROBE=n
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_BUILD_WERROR=n
CONFIG_XNU_CONSTANT_UPLOADS_PROBE=n
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_AES=n
CONFIG_XNU_NATIVE_AIR_INIT=n
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_OFFLINE_GPU=n
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_NATIVE_TRUST_CACHE=n
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_VIRTIO_CONSOLE=n
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_CACHE_CARRIER=n
CONFIG_XNU_OWNER_CACHE_CARRIER_WRONG_UUID=n
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
